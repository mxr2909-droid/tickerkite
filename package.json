{
  "name": "tickerkite",
  "productName": "Tickerkite",
  "version": "1.3.0",
  "description": "Desktop market news terminal for Mac: ranks the biggest US and global market-moving headlines from live feeds.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac",
    "update": "bash install.sh",
    "release": "electron-builder --mac --publish always"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.tickerkite.app",
    "productName": "Tickerkite",
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "files": [
      "src/**",
      "renderer/**",
      "legal/**",
      "package.json"
    ],
    "copyright": "Copyright © 2026 Tickerkite",
    "publish": [
      {
        "provider": "github",
        "owner": "mxr2909-droid",
        "repo": "tickerkite",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
