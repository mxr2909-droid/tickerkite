{
  "name": "wire-terminal",
  "productName": "WIRE",
  "version": "0.1.0",
  "description": "Desktop market news terminal: ranks the biggest US and global market-moving headlines from live feeds.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac",
    "update": "bash install.sh"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.wire.terminal",
    "productName": "WIRE",
    "mac": {
      "category": "public.app-category.finance",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "darkModeSupport": true
    },
    "files": ["src/**", "renderer/**", "package.json"]
  }
}
